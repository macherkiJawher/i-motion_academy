DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_NAME=imotion_dev

# Automatic notification emails (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM="i-Motion Academy <no-reply@i-motion.academy>"
PUBLIC_APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# Origins allowed by the API, separated by commas (optional).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Authentication
# Generate a strong random value locally; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
SESSION_SECRET=replace-with-a-long-random-session-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Public Assistant (server-side only; never expose through VITE_* variables)
GEMINI_API_KEY=replace-with-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=600

# Admin Copilot (server-side only; isolated from the public assistant)
ADMIN_ASSISTANT_GEMINI_API_KEY=replace-with-admin-copilot-gemini-api-key
ADMIN_ASSISTANT_GEMINI_MODEL=gemini-3.5-flash-lite
ADMIN_ASSISTANT_GEMINI_TIMEOUT_MS=15000
ADMIN_ASSISTANT_GEMINI_MAX_OUTPUT_TOKENS=600
